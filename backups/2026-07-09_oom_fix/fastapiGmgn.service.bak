[Unit]
Description=fastapiGmgn (FastAPI) - uvicorn on :2000
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/app/fastapiGmgn
Environment="PATH=/home/ubuntu/app/fastapiGmgn/venv/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/app/fastapiGmgn/venv/bin/uvicorn main:app --host 0.0.0.0 --port 2000 --workers 1
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10

# 日志交给 journalctl（-u fastapiGmgn）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastapiGmgn

# 安全选项（关键：必须允许写 logs/ 目录）
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/app/fastapiGmgn
PrivateTmp=true

[Install]
WantedBy=multi-user.target
